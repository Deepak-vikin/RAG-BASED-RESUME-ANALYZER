# OpenRouter API Key (Required for LLM inference)
# Obtain your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default OpenRouter model (configurable)
# Examples:
# meta-llama/llama-3.3-70b-instruct
# meta-llama/llama-3.3-70b-instruct:free
# google/gemini-2.0-flash-001
# anthropic/claude-3.5-sonnet
# openai/gpt-4o-mini
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenRouter site info for rankings & attribution
OPENROUTER_SITE_URL=https://document-analyzer.vercel.app
OPENROUTER_APP_NAME=Document Analyzer RAG

# Allowed frontend origins for CORS (comma-separated, or * for development)
# For production on Render, set this to your deployed Vercel domain:
# FRONTEND_ORIGIN=https://your-document-analyzer.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Persistent Data Storage Path
# In production on Render with a Persistent Disk mounted at /var/data:
# DATA_DIR=/var/data
DATA_DIR=./data

# RAG & Chunking settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MAX_UPLOAD_SIZE_MB=30

