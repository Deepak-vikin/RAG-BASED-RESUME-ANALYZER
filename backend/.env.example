# ─── OpenRouter API ─────────────────────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
# Format: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Any model available on OpenRouter — free models work fine for testing.
# Browse models: https://openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: shown in OpenRouter dashboard for your app's requests
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_APP_NAME=DocuQuery AI

# ─── Storage ────────────────────────────────────────────────────────────────
# Local development: ./data  (relative to backend/ directory)
# Render paid tier with Persistent Disk: /var/data
DATA_DIR=./data

# ─── CORS ───────────────────────────────────────────────────────────────────
# "*" = allow all origins (fine for dev or public APIs).
# Production: set to your exact Vercel URL — no trailing slash, no wildcard.
# Example: FRONTEND_ORIGIN=https://docuquery-ai.vercel.app
FRONTEND_ORIGIN=*

# ─── RAG Settings ───────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=5

# ─── Limits ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=30

# ─── Environment ────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
